    {
      "section": "live_diagnosis_trigger",
      "at": "2026-09-30T16:23:29.03668+00:00",
      "rows": [
        {
          "tgname": "pipeline_tasks_single_diagnosis",
          "tgenabled": "O",
          "definition": "CREATE TRIGGER pipeline_tasks_single_diagnosis BEFORE INSERT OR UPDATE OF task_type, status ON public.pipeline_tasks FOR EACH ROW EXECUTE FUNCTION enforce_single_active_demand_diagnosis()",
          "function_definition": "CREATE OR REPLACE FUNCTION public.enforce_single_active_demand_diagnosis()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nBEGIN\n  IF NEW.task_type = 'demand_diagnosis'\n     AND NEW.status IN ('queued', 'claimed', 'running') THEN\n    PERFORM pg_advisory_xact_lock(1129074037);\n    IF EXISTS (\n       SELECT 1\n       FROM pipeline_tasks active\n       WHERE active.task_type = 'demand_diagnosis'\n         AND active.status IN ('queued', 'claimed', 'running')\n         AND active.id IS DISTINCT FROM NEW.id\n     ) THEN\n      RETURN NULL;\n    END IF;\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n"
        }
      ]
    }
